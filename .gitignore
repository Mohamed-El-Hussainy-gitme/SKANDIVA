# ============================================================
# Skandiva Stockholm — Git Ignore Configuration
# ============================================================

# 1. Environment & Sensitive Credentials (CRITICAL)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 2. Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store

# 3. Next.js Build Outputs & Cache
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts.bak

# 4. Logs & Debugging Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.pid
*.seed
*.pid.lock

# 5. Local Uploads & Temporary Media
public/uploads/
.tempmediaStorage/
.user_uploaded/

# 6. Python Artifacts (Utility & Migration Scripts)
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# 7. IDE & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
*.sublime-workspace
*.sublime-project

# 8. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 9. Archives, Zips & Database Dumps
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
*.old
*.orig
